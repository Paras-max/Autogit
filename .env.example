# GitHub Authentication
GITHUB_TOKEN=

# AI Provider Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default AI Provider (e.g. openai, anthropic, gemini)
DEFAULT_AI_PROVIDER=gemini

# Git Identity (Leave blank to use existing global/local Git config)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Application & Database Settings
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./autogit.db

# Monitoring & Execution Settings
DEBOUNCE_INTERVAL_SECONDS=1.0
GIT_RECONCILIATION_INTERVAL_SECONDS=30.0
QUIET_PERIOD_SECONDS=3.0

# Phase 3 Scheduler & Autonomous Development
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_DAYS_PER_WEEK=5
SCHEDULER_CATCH_UP_POLICY=single
AUTONOMOUS_BRANCH_PREFIX=autogit/dev

# Optional Local Security Token for API Approval Endpoints
AUTOGIT_AUTH_TOKEN=
